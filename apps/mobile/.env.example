# Copy to .env.local. Never commit real values.
# Same Supabase project as apps/web — these are the browser-safe anon
# credentials (see apps/web/.env.example). Expo inlines EXPO_PUBLIC_* vars
# at build time; there is no server-only secret in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed apps/web app, used only for the two mobile-facing
# API routes that need a server-side secret (message generation, voice
# transcription) — see apps/web/src/app/api/mobile/.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
