# Copy to .env.local (apps/web) and fill in real values. Never commit secrets.

# --- Supabase --------------------------------------------------------------
# Project URL and anon key are safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security. Server-only. Never expose to
# the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------
# Public base URL of the deployed app, used for auth redirects and links in
# transactional email/push.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (transactional, reminders only) ---------------------------------
# Provider-specific; wired behind the email adapter in Stage 2.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- AI (Stage 3) ------------------------------------------------------
# Leave unset to fall back to the deterministic demo generator.
AI_PROVIDER_API_KEY=

# --- Observability -----------------------------------------------------
# Leave unset to disable; see docs/architecture.md threat model.
ERROR_MONITORING_DSN=
