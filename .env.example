# Copy to .env.local (apps/web) and fill in real values. Never commit secrets.

# --- Supabase --------------------------------------------------------------
# Project URL and anon key are safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security. Server-only. Never expose to
# the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------
# Public base URL of the deployed app, used for auth redirects and links in
# transactional email/push.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (transactional, reminders only) ---------------------------------
# Resend API key + verified sender. Leave both unset to use the console/log
# fallback (see apps/web/src/server/notifications/email-provider.ts).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Web push (reminders) ---------------------------------------------------
# Self-generated VAPID key pair — no third-party account needed. Generate
# with `npx web-push generate-vapid-keys`. Leave unset to use the console/log
# fallback (see apps/web/src/server/notifications/push-provider.ts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# The public key must also be readable in the browser to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Cron (reminder discovery / outbox processing) --------------------------
# Shared secret the scheduled routes require in an Authorization header, so
# they can't be triggered by anyone who finds the URL. Generate any random
# string.
CRON_SECRET=

# --- AI (Stage 3) ------------------------------------------------------
# Leave unset to fall back to the deterministic demo generator.
AI_PROVIDER_API_KEY=

# --- Observability -----------------------------------------------------
# Leave unset to disable; see docs/architecture.md threat model.
ERROR_MONITORING_DSN=
